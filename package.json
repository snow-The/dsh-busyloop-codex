{
  "name": "@snow-the/dsh-busyloop-codex",
  "version": "0.1.4",
  "description": "dsh-busyloop family — paradigm 1: OpenAI Codex CLI bridge for DSH (task executor, code review, security audit, AGENTS.md support).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@deepseek-ai/* --log-level=warning",
    "test": "node -e \"if(process.env.CI&&!process.env.OPENAI_API_KEY)process.exit(0)\" && node --test --test-concurrency=1"
  },
  "keywords": [
    "dsh",
    "plugin",
    "codex",
    "openai",
    "agent"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "allowScripts": [
    "hono",
    "typescript"
  ],
  "dependencies": {
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  }
}